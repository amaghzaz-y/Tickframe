<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata for NuGet publishing -->
    <PackageId>Tickframe</PackageId>
    <Version>0.1.0</Version>
    <Authors>Yassine</Authors>
    <Description>Tickframe library.</Description>
    <PackageTags>fsharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Domain.fs" />
    <Compile Include="src/Indicators/Common.fs" />
    <Compile Include="src/Indicators/Trend.fs" />
    <Compile Include="src/Indicators/Momentum.fs" />
    <Compile Include="src/Indicators/Volatility.fs" />
    <Compile Include="src/Indicators/Volume.fs" />
    <Compile Include="src/Indicators/Directional.fs" />
    <Compile Include="src/Indicators/Price.fs" />
    <Compile Include="src/Services.fs" />
    <Compile Include="src/Infrastructure.fs" />
    <Compile Include="src/Evaluator.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
